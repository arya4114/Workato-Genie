        "number": 2,
        "provider": "py_eval",
        "name": "invoke_custom_py_code",
        "as": "f52991fc",
        "keyword": "action",
        "input": {
          "code": "import zipfile\nimport io\nimport base64\nimport binascii\nimport xml.etree.ElementTree as ET\n\ndef extract_text_from_docx(file_content):\n    # Case 1: Already bytes (Workato may send this way)\n    if isinstance(file_content, bytes):\n        file_bytes = file_content\n\n    # Case 2: String starting with 0x (hex)\n    elif isinstance(file_content, str) and file_content.lower().startswith(\"0x\"):\n        hex_str = file_content[2:].strip()\n        file_bytes = binascii.unhexlify(hex_str)\n\n    # Case 3: String base64\n    elif isinstance(file_content, str):\n        file_bytes = base64.b64decode(file_content.strip())\n\n    else:\n        raise ValueError(\"Unsupported input type for file_content\")\n\n    # Open as a zip (DOCX = zip archive)\n    with zipfile.ZipFile(io.BytesIO(file_bytes)) as docx_zip:\n        with docx_zip.open(\"word/document.xml\") as doc_xml:\n            tree = ET.parse(doc_xml)\n            root = tree.getroot()\n\n            # Word XML namespace\n            ns = {\"w\": \"http://schemas.openxmlformats.org/wordprocessingml/2006/main\"}\n\n            # Extract text by paragraphs\n            paragraphs = []\n            for para in root.findall(\".//w:p\", ns):\n                texts = []\n                for node in para.findall(\".//w:t\", ns):\n                    if node.text:\n                        texts.append(node.text)\n                if texts:\n                    paragraphs.append(\"\".join(texts))\n\n            return \"\\n\".join(paragraphs)\n\ndef main(inputs):\n    file_content = inputs[\"file_content\"]\n    extracted_text = extract_text_from_docx(file_content)\n    return {\"text\": extracted_text}",
          "name": "convert docx to text",
          "code_input": {
            "schema": "[{\"name\":\"Docx_File\",\"type\":\"string\",\"optional\":true,\"label\":\"Docx_File\",\"details\":{\"real_name\":\"Docx_File\"},\"control_type\":\"text\",\"parent\":[\"code_input\",\"data\"]}]",
            "data": {
